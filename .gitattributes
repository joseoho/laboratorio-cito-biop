* text=auto eol=lf

# Windows: cmd.exe no ejecuta archivos .bat con saltos de linea LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
